# Copy this file to .env and fill in your keys.
# Never commit .env to version control.

# Anthropic — used by analyzer, personalizer, site_generator agents
ANTHROPIC_API_KEY=sk-ant-...

# Google Places API — used by scraper to discover local businesses
GOOGLE_PLACES_API_KEY=AIza...

# Instantly.ai — used by outreach agent to send email sequences
INSTANTLY_API_KEY=...

# Vercel — used by site_generator to deploy demo sites
VERCEL_TOKEN=...

# Optional overrides
DB_PATH=data/leads.db
